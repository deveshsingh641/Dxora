# ==============================================================================
# Multi-Platform Automated Posting System Configuration
# ==============================================================================
# Copy this file to .env and fill in the credentials for platforms you wish to test.
# Any platform with missing credentials will fail gracefully without blocking others.
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=4000
ENVIRONMENT=development

# Optional: Enable Mock/Simulation Mode for testing without live API keys
# Set to 'true' to return simulated successful postings for unconfigured platforms,
# or 'false' (default) to test strict real-world API validation and error handling.
ENABLE_MOCK_FALLBACK=false

# ------------------------------------------------------------------------------
# 1. Telegram Bot API
# Create a bot via @BotFather on Telegram, create a public channel, add bot as admin.
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 2. Discord Webhook API
# Create a Discord Server -> Channel Settings -> Integrations -> Webhooks -> Copy Webhook URL.
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=
DISCORD_GUILD_ID=

# ------------------------------------------------------------------------------
# 3. Mastodon REST API
# Instance URL (e.g., https://mastodon.social) and Access Token from Preferences -> Development.
# ------------------------------------------------------------------------------
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 4. Bluesky (AT Protocol)
# Handle (e.g. user.bsky.social) and App Password from Settings -> App Passwords.
# ------------------------------------------------------------------------------
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social

# ------------------------------------------------------------------------------
# 5. Hugging Face Community (LLM Platform)
# User Access Token from https://huggingface.co/settings/tokens
# Target repository (e.g. your-username/announcements or your-model-id)
# ------------------------------------------------------------------------------
HUGGINGFACE_TOKEN=
HUGGINGFACE_REPO_ID=

# ------------------------------------------------------------------------------
# 6. Dev.to / Forem API
# API Key from https://dev.to/settings/extensions -> Generate API Key
# ------------------------------------------------------------------------------
DEVTO_API_KEY=
